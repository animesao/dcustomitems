{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DC-CustomItems item",
  "type": "object",
  "additionalProperties": { "$ref": "#/definitions/item" },
  "definitions": {
    "item": {
      "type": "object",
      "properties": {
        "type": { "enum": ["RUNE", "TOOL", "ARMOR", "CONSUMABLE"] },
        "activation-slot": { "enum": ["HAND", "OFFHAND", "HEAD", "CHEST", "LEGS", "FEET"] },
        "placeable": { "type": "boolean" },
        "permission": { "type": "string" },
        "click-cooldown": { "type": "integer", "minimum": 0 },
        "max-uses": { "type": "integer", "minimum": -1 },
        "duration": { "type": "integer", "minimum": -1 },
        "allowed-worlds": { "type": "array", "items": { "type": "string" } },
        "disabled-worlds": { "type": "array", "items": { "type": "string" } },
        "item": { "type": "object" },
        "effects": { "type": "array", "items": { "type": "string" } },
        "attributes": { "type": "object" },
        "lore": { "type": "array", "items": { "type": "string" } },
        "left-click-actions": { "type": "array", "items": { "type": "string" } },
        "right-click-actions": { "type": "array", "items": { "type": "string" } },
        "triggers": { "type": "object" },
        "recipes": {
          "type": "object",
          "properties": {
            "shaped": { "type": "array" },
            "shapeless": { "type": "array" },
            "furnace": { "type": "array" },
            "smithing": { "type": "array" },
            "stonecutting": { "type": "array" }
          },
          "additionalProperties": false
        }
      },
      "required": ["item"]
    }
  }
}
